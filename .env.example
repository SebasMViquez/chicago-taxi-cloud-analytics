# Frontend
VITE_API_BASE_URL=http://localhost:7071

# Azure Functions API
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated
DASHBOARD_SUMMARY_PROVIDER=Development

# Azure SQL configuration - never commit real secret values
SQL_SERVER_NAME=
SQL_DATABASE_NAME=
SQL_AUTH_MODE=ManagedIdentity
SQL_ADMINISTRATOR_PASSWORD=
DEVELOPER_PUBLIC_IP=
ENTRA_SQL_ADMINISTRATOR_LOGIN=
ENTRA_SQL_ADMINISTRATOR_OBJECT_ID=

# Processor execution
PROCESSING_MODE=local
PROCESSING_INPUT_PATH=processing/tests/fixtures/chicago_taxi_sample.csv
PROCESSING_OUTPUT_DIR=processing/.local-output
PROCESSING_PROCESSED_PATH=processed/chicago-taxi/year=2023/processed_trips.parquet
PROCESSING_RESULTS_PREFIX=results/chicago-taxi/latest
PROCESSING_LOAD_SQL=false

# Azure Storage configuration - prefer Managed Identity/RBAC
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=chicago-taxi

# GitHub Actions / Azure deployment values should be configured as GitHub variables.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

