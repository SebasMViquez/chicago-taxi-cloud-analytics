# Frontend
VITE_API_BASE_URL=http://localhost:7071

# Azure Functions API
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated
DASHBOARD_SUMMARY_PROVIDER=Development

# Future Azure SQL configuration - never commit real values
SQL_SERVER_NAME=
SQL_DATABASE_NAME=
SQL_AUTH_MODE=ManagedIdentity

# Processor local execution
PROCESSING_INPUT_CSV=processing/tests/fixtures/chicago_taxi_sample.csv
PROCESSING_OUTPUT_DIR=processing/.local-output

# Future Azure Storage configuration - prefer Managed Identity/RBAC
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=

